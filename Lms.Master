<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Lms.master.cs" Inherits="FlmWebFormsApp.Lms" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>LMS</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>

    <h1 align="center">Welcome to LMS</h1><hr />
    
    <form id="form1" runat="server">
        <div>
                            <asp:Menu ID="Menu1" runat="server" BackColor="#E3EAEB" DynamicHorizontalOffset="2" Font-Names="Verdana" Font-Size="0.8em" ForeColor="#666666" StaticSubMenuIndent="10px">
    <DynamicHoverStyle BackColor="#666666" ForeColor="White" />
    <DynamicMenuItemStyle HorizontalPadding="5px" VerticalPadding="2px" />
    <DynamicMenuStyle BackColor="#E3EAEB" />
    <DynamicSelectedStyle BackColor="#1C5E55" />
    <Items>
        <asp:MenuItem NavigateUrl="~/Default.aspx" Text="Home" Value="Home"></asp:MenuItem>
        <asp:MenuItem Text="Faculty Login" Value="Faculty" NavigateUrl="~/Faculty/FacultyLogin.aspx">
        </asp:MenuItem>
        <asp:MenuItem Text="Student" Value="Student">
            <asp:MenuItem NavigateUrl="~/Student/StudRegistration.aspx" Text="Register" Value="Register"></asp:MenuItem>
            <asp:MenuItem NavigateUrl="~/Student/StudentLogin.aspx" Text="Login" Value="Login"></asp:MenuItem>
        </asp:MenuItem>
    </Items>
    <StaticHoverStyle BackColor="#666666" ForeColor="White" />
    <StaticMenuItemStyle HorizontalPadding="5px" VerticalPadding="2px" />
    <StaticSelectedStyle BackColor="#1C5E55" />
</asp:Menu><hr />
        </div>
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                <!-- This is where child forms body goes-->
                
            </asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>
